# 已测单流实验候选；路径由调用者环境提供。
export QWEN36_PROFILE=long-prefill
export QWEN36_GROUPED_CHUNK_TOKENS=512
# 48G/112K优先原生FP16 KV；需要节约KV时可显式设为1。
export QWEN36_C8_ENABLED="${QWEN36_C8_ENABLED:-0}"
export ENABLE_PREFIX_CACHING=0
export PORT=18024
export CONTAINER_NAME=qwen36-tp1-48g-112k
