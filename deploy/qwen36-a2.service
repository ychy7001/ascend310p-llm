[Unit]
Description=Qwen3.6 W4A8 C8 MTP2 long-prefill on a2

[Service]
Type=simple
WorkingDirectory=/home/ychy/services/qwen36/repo
ExecStart=/bin/bash -c 'source /home/ychy/services/qwen36/repo/deploy/a2.env; exec bash scripts/run-candidate.sh'
ExecStop=/usr/bin/podman stop -t 90 qwen36-tp1-48g-112k
Restart=on-failure
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=default.target
