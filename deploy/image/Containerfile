ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS base

FROM base AS production
RUN --mount=type=bind,source=.,target=/image-source,ro \
    python3 -S /image-source/deploy/image/verify-image.py --production-base /image-source/deploy/image/production-amd64.json \
 && git -C /vllm-workspace/vllm-ascend apply /image-source/patches/production/attention-mask.patch \
 && python3 -m pip install --no-deps --require-hashes -r /image-source/deploy/image/production-requirements.txt
# Production layer 22 also contains these empty builder-generated files.
COPY --chmod=0700 deploy/image/empty /etc/hostname
COPY --chmod=0700 deploy/image/empty /etc/resolv.conf
LABEL org.opencontainers.image.revision="f8f58951e43054b2da7f7e200939d01f933197cb" \
      org.opencontainers.image.title="vllm-ascend-310P-PI1-live-SplitFuse-mask-v023-overlay"

FROM base AS runtime
USER root
COPY rootfs/ /
RUN TORCH_DEVICE_BACKEND_AUTOLOAD=0 python3 -S /opt/qwen36/verify-image.py --base \
 && if [ -d /usr/local/python3.12.13/lib/python3.12/site-packages/triton ]; then mv /usr/local/python3.12.13/lib/python3.12/site-packages/triton /opt/triton-disabled; fi
ENV PYTHONPATH=/c8bootstrap TORCH_DEVICE_BACKEND_AUTOLOAD=0 ATEN_CPU_CAPABILITY=default VLLM_WORKER_MULTIPROC_METHOD=spawn OMP_NUM_THREADS=1
ENTRYPOINT ["bash", "/opt/qwen36/start.sh"]
