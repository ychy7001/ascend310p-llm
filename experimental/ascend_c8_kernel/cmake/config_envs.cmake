find_program(PYTHON_EXECUTABLE NAMES python3)
execute_process(COMMAND ${PYTHON_EXECUTABLE} -c "import torch,os,sysconfig,site; print(os.path.realpath(os.path.dirname(torch.__file__)),os.path.join(site.getsitepackages()[0],'torch_npu'),torch.compiled_with_cxx11_abi(),sysconfig.get_path('include'),end='')" OUTPUT_VARIABLE E)
string(REPLACE " " ";" E "${E}")
list(GET E 0 TORCH_DIR)
list(GET E 1 TORCH_NPU_DIR)
list(GET E 2 ABI)
list(GET E 3 PYTHON_INCLUDE_DIR)
if(ABI STREQUAL "True")
  add_compile_options(-D_GLIBCXX_USE_CXX11_ABI=1)
else()
  add_compile_options(-D_GLIBCXX_USE_CXX11_ABI=0)
endif()
