From 278ad7293966f24f37dad31ad63bc543e02db4f3 Mon Sep 17 00:00:00 2001
From: ychy7001 <2043343224@qq.com>
Date: Sun, 15 Nov 2026 09:19:52 +0800
Subject: [PATCH] test: add 310P compressed SplitFuse causal repro

Compare contexts 2048 and 2049 with paired legacy and compressed calls. Change only future V and check a last-row positive control. Keep this as an on-demand example while the backend behavior is investigated.

Signed-off-by: ychy7001 <2043343224@qq.com>
---
 examples/310p_splitfuse_causal_repro.py | 99 +++++++++++++++++++++++++
 1 file changed, 99 insertions(+)
 create mode 100644 examples/310p_splitfuse_causal_repro.py

diff --git a/examples/310p_splitfuse_causal_repro.py b/examples/310p_splitfuse_causal_repro.py
new file mode 100644
index 000000000..eabefb1ab
--- /dev/null
+++ b/examples/310p_splitfuse_causal_repro.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM Ascend project
+"""Check whether compressed SplitFuse reads future values on Ascend 310P.
+
+Run inside a 310P torch-npu environment with legacy and v2 SplitFuse:
+    python examples/310p_splitfuse_causal_repro.py --device 0
+
+No server or model is required. Exit 1 means the causal invariant failed.
+"""
+
+import argparse
+import json
+
+import torch
+import torch_npu
+
+BLOCK_SIZE = 64
+HEAD_SIZE = 256
+QUERY_HEADS = 8
+QUERY_LEN = 384
+QUERY_ROW = 123
+MASK_SIZE = 2048
+FRACTAL_NZ = 29
+COMPRESSED_MASK_TYPE = 5
+FIRST_FUTURE_OFFSET = 4
+MARKERS = 16
+MARKER_VALUE = 64.0
+
+
+def run_case(context: int, device: str, compressed_mask: torch.Tensor) -> dict:
+    blocks = (context + BLOCK_SIZE - 1) // BLOCK_SIZE
+    slots = torch.arange(blocks * BLOCK_SIZE, dtype=torch.int32, device=device)
+    cutoff = context - QUERY_LEN + QUERY_ROW
+    shape = (blocks, HEAD_SIZE // 16, BLOCK_SIZE, 16)
+    dtype = torch.float16
+    kc, vc = [
+        torch_npu.empty_with_format(size=shape, dtype=dtype, device=device, acl_format=FRACTAL_NZ) for _ in range(2)
+    ]
+    key = torch.zeros((slots.numel(), 1, HEAD_SIZE), dtype=dtype, device=device)
+    value = torch.zeros_like(key)
+    query = torch.zeros((QUERY_LEN, QUERY_HEADS, HEAD_SIZE), dtype=dtype, device=device)
+    out = torch.empty_like(query)
+    width = (context + 15) // 16 * 16
+    positions = torch.arange(context - QUERY_LEN, context, device=device)
+    dense = torch.zeros((QUERY_LEN, width), dtype=dtype, device=device)
+    dense.masked_fill_(torch.arange(width, device=device)[None, :] > positions[:, None], -torch.inf)
+    nz = dense.reshape(1, QUERY_LEN, width // 16, 16).permute(0, 2, 1, 3).contiguous()
+    legacy_mask = torch_npu.npu_format_cast(nz, FRACTAL_NZ)
+    args = dict(
+        query=query,
+        key_cache=kc,
+        value_cache=vc,
+        block_table=torch.arange(blocks, dtype=torch.int32, device=device).reshape(1, -1),
+        seq_len=torch.tensor([QUERY_LEN], dtype=torch.int32),
+        context_lens=torch.tensor([context], dtype=torch.int32, device=device),
+        num_kv_heads=1,
+        num_heads=QUERY_HEADS,
+        scale_value=HEAD_SIZE**-0.5,
+        out=out,
+    )
+    result: dict = {"context": context, "query_row": QUERY_ROW, "causal_cutoff": cutoff}
+    for label in ("zero", "future"):
+        if label == "future":
+            start = cutoff + FIRST_FUTURE_OFFSET
+            value[start : start + MARKERS].fill_(MARKER_VALUE)
+        torch_npu._npu_reshape_and_cache(key=key, value=value, key_cache=kc, value_cache=vc, slot_indices=slots)
+        torch_npu._npu_paged_attention_splitfuse(mask=legacy_mask, **args)
+        legacy = out[[QUERY_ROW, QUERY_LEN - 1], 0, 0].cpu().tolist()
+        torch_npu._npu_paged_attention_splitfuse_v2(mask=compressed_mask, mask_type=COMPRESSED_MASK_TYPE, **args)
+        compressed = out[[QUERY_ROW, QUERY_LEN - 1], 0, 0].cpu().tolist()
+        expected_last = MARKERS * MARKER_VALUE / context if label == "future" else 0.0
+        for samples in (legacy, compressed):
+            if not abs(samples[1] - expected_last) <= 0.001:
+                raise RuntimeError(f"last-row KV control failed: {samples[1]=}, {expected_last=}")
+        result[label] = {"legacy_row": legacy[0], "compressed_row": compressed[0], "last_row": compressed[1]}
+    result["legacy_causal"] = all(result[key]["legacy_row"] == 0 for key in ("zero", "future"))
+    result["compressed_causal"] = all(result[key]["compressed_row"] == 0 for key in ("zero", "future"))
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--device", type=int, default=0)
+    args = parser.parse_args()
+    if not hasattr(torch_npu, "_npu_paged_attention_splitfuse_v2"):
+        parser.error("this repro requires torch-npu with _npu_paged_attention_splitfuse_v2")
+    torch.npu.set_device(args.device)
+    torch_npu.npu.set_compile_mode(jit_compile=False)
+    torch_npu.npu.config.allow_internal_format = True
+    device = f"npu:{args.device}"
+    mask = torch.full((MASK_SIZE, MASK_SIZE), -10000.0, dtype=torch.float16, device=device).triu_(1)
+    results = [run_case(context, device, mask) for context in (MASK_SIZE, MASK_SIZE + 1)]
+    print(json.dumps({"device": args.device, "torch_npu": torch_npu.__version__, "results": results}, indent=2))
+    return 0 if all(row["legacy_causal"] and row["compressed_causal"] for row in results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
